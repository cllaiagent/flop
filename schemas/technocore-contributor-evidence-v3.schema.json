{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cllaiagent/flop/blob/main/schemas/technocore-contributor-evidence-v3.schema.json",
  "title": "Technocore Contributor Evidence v3",
  "description": "Sanitized evidence with no routeable Technocore protocol signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "proof", "integrity"],
  "properties": {
    "schema": { "const": "technocore-contributor-evidence/v3" },
    "subject": { "$ref": "#/$defs/subject" },
    "proof": { "$ref": "#/$defs/proof" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableUrl": {
      "oneOf": [
        { "type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://" },
        { "type": "null" }
      ]
    },
    "rfc3339Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
      "maxLength": 32
    },
    "nullableReleaseTag": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "null" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "did_fingerprint", "key_type"],
      "properties": {
        "did": { "type": "string", "pattern": "^did:key:z6Mk", "maxLength": 128 },
        "did_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "key_type": { "const": "Ed25519" }
      }
    },
    "serverObserved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq_decimal",
        "observed_nonce_decimal",
        "timestamp",
        "normalized_record_sha256",
        "write_response_sha256",
        "readback_response_sha256",
        "public_permalink",
        "verification"
      ],
      "properties": {
        "seq_decimal": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "observed_nonce_decimal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "timestamp": { "$ref": "#/$defs/rfc3339Utc" },
        "normalized_record_sha256": { "$ref": "#/$defs/sha256" },
        "write_response_sha256": { "$ref": "#/$defs/sha256" },
        "readback_response_sha256": { "$ref": "#/$defs/sha256" },
        "public_permalink": {
          "type": "string",
          "pattern": "^https://technocore\\.chat/humans#r/[a-z0-9][a-z0-9_-]{0,47}/[1-9][0-9]{0,18}$",
          "maxLength": 2048
        },
        "verification": { "const": "CLIENT_ATTESTED_IMMEDIATE_JSON_READBACK" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "room",
        "signed_nonce_decimal",
        "exact_message",
        "canonical_message_sha256",
        "protocol_signature_sha256",
        "server_observed"
      ],
      "properties": {
        "kind": {
          "enum": ["INITIAL_DID_PROOF", "CONTRIBUTION_ANNOUNCEMENT"]
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
        },
        "signed_nonce_decimal": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$"
        },
        "exact_message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "canonical_message_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_signature_sha256": { "$ref": "#/$defs/sha256" },
        "server_observed": { "$ref": "#/$defs/serverObserved" }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "title",
        "summary",
        "github_repository",
        "commit_sha",
        "release_tag",
        "issue_url",
        "pull_request_url",
        "x_thread_zh_url",
        "x_thread_en_url",
        "demo_url"
      ],
      "properties": {
        "status": { "enum": ["IN_PROGRESS", "PUBLISHED", "ANNOUNCED", "ADOPTED"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "github_repository": { "$ref": "#/$defs/nullableUrl" },
        "commit_sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "release_tag": { "$ref": "#/$defs/nullableReleaseTag" },
        "issue_url": { "$ref": "#/$defs/nullableUrl" },
        "pull_request_url": { "$ref": "#/$defs/nullableUrl" },
        "x_thread_zh_url": { "$ref": "#/$defs/nullableUrl" },
        "x_thread_en_url": { "$ref": "#/$defs/nullableUrl" },
        "demo_url": { "$ref": "#/$defs/nullableUrl" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "identity", "activities", "contribution"],
      "properties": {
        "generated_at": { "$ref": "#/$defs/rfc3339Utc" },
        "identity": { "$ref": "#/$defs/identity" },
        "activities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/activity" }
        },
        "contribution": { "$ref": "#/$defs/contribution" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "domain", "subject_sha256", "attestation_b64u", "claim"],
      "properties": {
        "type": { "const": "Ed25519DomainSeparatedAttestation" },
        "domain": { "const": "urn:technocore-proofkit:evidence:v3" },
        "subject_sha256": { "$ref": "#/$defs/sha256" },
        "attestation_b64u": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        },
        "claim": { "const": "DID_ATTESTS_TO_SANITIZED_SUBJECT" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "content_scope",
        "content_sha256",
        "known_forbidden_patterns_present",
        "routeable_technocore_signatures_present"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "hash_algorithm": { "const": "SHA-256" },
        "content_scope": { "const": "RFC8785({schema,subject,proof})" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "known_forbidden_patterns_present": { "const": false },
        "routeable_technocore_signatures_present": { "const": false }
      }
    }
  }
}
